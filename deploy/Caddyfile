# One domain for everything: the React app, and the Go API under /api and /healthz.
# Caddy gets and renews the HTTPS certificate for {$DOMAIN} by itself, and
# redirects http to https. With DOMAIN=localhost it uses its own local CA instead.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API. Same origin as the app, so no CORS is needed.
	@api path /api/* /healthz
	handle @api {
		reverse_proxy api:8080
	}

	# The React app. Unknown paths get index.html so React Router can handle
	# deep links like /orders/123.
	handle {
		root * /srv
		@assets path /assets/*
		# Vite puts a content hash in asset file names, so they never change.
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
