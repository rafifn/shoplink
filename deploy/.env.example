# Production settings for deploy/docker-compose.prod.yml.
# Copy to deploy/.env ON THE SERVER ONLY and replace every value. Never commit
# the real file, and never reuse the local passwords from the repo's .env.example.
# Make the passwords long and URL-safe (letters and digits): openssl rand -hex 24

# The domain Caddy serves and gets the HTTPS certificate for (its DNS A record
# must point at the server).
DOMAIN=shop.example.com

# Which image version to run, set by the deploy (#10): a commit SHA.
IMAGE_TAG=latest

# Postgres superuser, used only to create the database on first start.
POSTGRES_PASSWORD=replace-me
# The app's database user (owns the schema, runs migrations).
SHOPLINK_DB_PASSWORD=replace-me
# Read-only user for inspecting data.
SHOPLINK_READONLY_PASSWORD=replace-me
