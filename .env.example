# Local development only. `make db-up` copies this to .env if .env is missing.
# These passwords protect a database bound to 127.0.0.1 on your machine; never reuse them anywhere else.

POSTGRES_PASSWORD=postgres-local-only
SHOPLINK_DB_PASSWORD=shoplink-local-only
SHOPLINK_READONLY_PASSWORD=readonly-local-only

# Used by the API and migrations (from #3 on).
DATABASE_URL=postgres://shoplink:shoplink-local-only@localhost:5432/shoplink?sslmode=disable

# Demo seller loaded by `make seed` (local only; sign in with these to try the app).
DEMO_SELLER_EMAIL=demo@shoplink.test
DEMO_SELLER_PASSWORD=demo-password-local-only

# Go API (`make api`). FRONTEND_ORIGIN is the Vite dev server, the only origin CORS allows.
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Frontend (Vite reads this file). The API's origin; leave empty in production,
# where the app and the API share a domain.
VITE_API_URL=http://localhost:8080
